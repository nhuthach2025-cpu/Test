-- Hàm tạo Nút Bật/Tắt tiêu chuẩn
local function CreateToggleButton(text, callback)
    local btn = Instance.new("TextButton")
    local btnCorner = Instance.new("UICorner")
    btn.Parent = Container
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundTransparency = 0.85
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14.000
    
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    local enabled = false
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            btn.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
            btn.BackgroundTransparency = 0.5
        else
            btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            btn.BackgroundTransparency = 0.85
        end
        callback(enabled, btn)
    end)
end

-- Hàm tạo Khung kết hợp: Ô Nhập Số + Nút Bật/Tắt
local function CreateCustomStatControl(labelText, defaultValue, normalValue, onToggle)
    local boxFrame = Instance.new("Frame")
    boxFrame.Parent = Container
    boxFrame.Size = UDim2.new(1, 0, 0, 35)
    boxFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    boxFrame.BackgroundTransparency = 0.85

    local frameCorner = Instance.new("UICorner")
    frameCorner.CornerRadius = UDim.new(0, 8)
    frameCorner.Parent = boxFrame

    local label = Instance.new("TextLabel")
    label.Parent = boxFrame
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 10, 0, 0)
    label.Size = UDim2.new(0.42, 0, 1, 0)
    label.Font = Enum.Font.SourceSansBold
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 13.000
    label.TextXAlignment = Enum.TextXAlignment.Left

    local textBox = Instance.new("TextBox")
    textBox.Parent = boxFrame
    textBox.Position = UDim2.new(0.43, 0, 0.15, 0)
    textBox.Size = UDim2.new(0.22, 0, 0.7, 0)
    textBox.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    textBox.BackgroundTransparency = 0.5
    textBox.Font = Enum.Font.SourceSansBold
    textBox.Text = tostring(defaultValue)
    textBox.TextColor3 = Color3.fromRGB(0, 255, 150)
    textBox.TextSize = 13.000

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 5)
    boxCorner.Parent = textBox

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = boxFrame
    toggleBtn.Position = UDim2.new(0.68, 0, 0.15, 0)
    toggleBtn.Size = UDim2.new(0.29, 0, 0.7, 0)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.BackgroundTransparency = 0.8
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.Text = "OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextSize = 13.000

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = toggleBtn

    local isEnabled = false
    local currentValue = defaultValue

    textBox.FocusLost:Connect(function()
        local val = tonumber(textBox.Text)
        if val then
            currentValue = val
            onToggle(isEnabled, currentValue)
        else
            textBox.Text = tostring(currentValue)
        end
    end)

    toggleBtn.MouseButton1Click:Connect(function()
        isEnabled = not isEnabled
        if isEnabled then
            toggleBtn.Text = "ON"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
            toggleBtn.BackgroundTransparency = 0.3
            onToggle(true, currentValue)
        else
            toggleBtn.Text = "OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            toggleBtn.BackgroundTransparency = 0.8
            onToggle(false, normalValue)
        end
    end)
end


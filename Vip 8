-- 5. ESP Player (Định vị + Tên + Máu đã sửa lỗi tự cập nhật khi chết / người chơi mới gia nhập)
local espFolder = game.CoreGui:FindFirstChild("ESP_Folder") or Instance.new("Folder", game.CoreGui)
espFolder.Name = "ESP_Folder"

local espEnabled = false
local playerConnections = {}

local function createESPForCharacter(plr, char)
    if plr == game.Players.LocalPlayer then return end
    
    local head = char:WaitForChild("Head", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not head or not hum then return end

    -- Xóa ESP cũ của player này nếu có
    local oldEsp = espFolder:FindFirstChild(plr.Name)
    if oldEsp then oldEsp:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = plr.Name
    bb.Adornee = head
    bb.Size = UDim2.new(0, 150, 0, 40)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.Parent = espFolder

    local txt = Instance.new("TextLabel", bb)
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Color3.fromRGB(255, 50, 50)
    txt.Font = Enum.Font.SourceSansBold
    txt.TextSize = 13
    txt.TextStrokeTransparency = 0.2

    local renderConn
    renderConn = game:GetService("RunService").RenderStepped:Connect(function()
        if not espEnabled or not char:IsDescendantOf(workspace) or hum.Health <= 0 then
            bb:Destroy()
            renderConn:Disconnect()
            return
        end
        txt.Text = string.format("%s\n❤️ %d/%d", plr.DisplayName, math.floor(hum.Health), math.floor(hum.MaxHealth))
    end)
end

local function trackPlayer(plr)
    if plr == game.Players.LocalPlayer then return end

    -- Lắng nghe khi nhân vật hồi sinh
    local conn = plr.CharacterAdded:Connect(function(char)
        if espEnabled then
            createESPForCharacter(plr, char)
        end
    end)
    playerConnections[plr] = conn

    -- Nếu nhân vật đã xuất hiện từ trước
    if plr.Character and espEnabled then
        createESPForCharacter(plr, plr.Character)
    end
end

CreateToggleButton("ESP (Định vị + Máu + Tên): OFF", function(state, btn)
    espEnabled = state
    if espEnabled then
        btn.Text = "ESP (Định vị + Máu + Tên): ON"
        
        -- Áp dụng cho các người chơi hiện có
        for _, plr in pairs(game.Players:GetPlayers()) do
            trackPlayer(plr)
        end

        -- Lắng nghe khi có người chơi mới vào server
        playerConnections["PlayerAdded"] = game.Players.PlayerAdded:Connect(function(plr)
            trackPlayer(plr)
        end)
    else
        btn.Text = "ESP (Định vị + Máu + Tên): OFF"
        espFolder:ClearAllChildren()
        
        -- Xóa các kết nối để tránh lag
        for plr, conn in pairs(playerConnections) do
            if typeof(conn) == "RBXScriptConnection" then
                conn:Disconnect()
            end
        end
        playerConnections = {}
    end
end)

